{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cubo CFOP",
  "version": "0.1.0",
  "identifier": "com.cubo.cfop",
  "build": {
    "beforeDevCommand": "trunk serve --config ui/Trunk.toml",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "trunk build --config ui/Trunk.toml",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Cubo CFOP",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
